# Configurações do Provedor LLM (OpenRouter / Gemini)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Configurações da Base de Dados SQLite
DATABASE_URL=sqlite:///./data/insurance_policie_analysis.db
SQLITE_DB=insurance_policie_analysis.db

# Configurações de Segurança e JWT
SECRET_KEY=sua_chave_secreta_jwt_para_ambientes_de_desenvolvimento
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configurações de OCR & Agentes
OCR_PROVIDER=pymupdf
LLM_PROVIDER=openrouter
LANG=pt
